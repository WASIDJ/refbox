# 使用 npm run configure 生成独立 token 和密码 hash；不要提交真实 .env。
REFBOX_ENGINE_TOKEN=replace-with-at-least-32-random-characters
REFBOX_PASSWORD_HASH='pbkdf2-sha256$600000$base64url-salt$base64url-derived-key'
PI_PROFILE_DIR=/Users/your-user/.pi/agent
REFBOX_DATABASE=/absolute/path/to/refbox/var/refbox.sqlite
REFBOX_WEB_DIR=/absolute/path/to/refbox/apps/web/dist
REFBOX_MODEL=kimi-k3
REFBOX_ENGINE_PORT=18801
REFBOX_ENGINE_URL=http://127.0.0.1:18801
REFBOX_LISTEN=127.0.0.1:8080
REFBOX_SECURE_COOKIE=false

# 平台、执行器、插件、验证器与动作代理使用独立凭据；configure 可补齐已有配置。
REFBOX_PLATFORM_TOKEN=replace-with-another-random-token
REFBOX_BROKER_TOKEN=replace-with-another-random-token
REFBOX_MONITOR_TOKEN=replace-with-another-random-token
REFBOX_VERIFIER_TOKEN=replace-with-another-random-token
REFBOX_SCRATCHPAD_TOKEN=replace-with-another-random-token
REFBOX_PLATFORM_DATABASE=/absolute/path/to/refbox/var/platform.sqlite
REFBOX_MONITOR_DATABASE=/absolute/path/to/refbox/var/monitor.sqlite
REFBOX_VERIFIER_DATABASE=/absolute/path/to/refbox/var/verifier.sqlite
REFBOX_SCRATCHPAD_DATABASE=/absolute/path/to/refbox/var/scratchpad.sqlite
REFBOX_BROKER_DATABASE=/absolute/path/to/refbox/var/broker.sqlite
REFBOX_PLATFORM_URL=http://127.0.0.1:8080
REFBOX_VERIFIER_URL=http://127.0.0.1:18812
REFBOX_BROKER_URL=http://127.0.0.1:18814
REFBOX_BROKER_LISTEN=127.0.0.1:18814
REFBOX_MONITOR_PORT=18811
REFBOX_VERIFIER_PORT=18812
REFBOX_SCRATCHPAD_PORT=18813
REFBOX_TUNNEL_METRICS_URL=http://127.0.0.1:18803
REFBOX_AUTO_REPAIR=true
REFBOX_ENVIRONMENT_ID=macmini-local
REFBOX_PUBLIC_URL=https://your-cloudflare-host.example
# 独立浏览器验收使用应用登录凭据；这里绝不能填写系统 root 密码。
REFBOX_VERIFY_PASSWORD=your-refbox-app-login-password
REFBOX_PLUGIN_MANIFESTS='[{"manifestUrl":"http://127.0.0.1:18811/manifest","credentialEnv":"REFBOX_MONITOR_TOKEN"},{"manifestUrl":"http://127.0.0.1:18813/manifest","credentialEnv":"REFBOX_SCRATCHPAD_TOKEN"}]'
